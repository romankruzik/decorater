---
import CatalogListing from "../../components/CatalogListing.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { catalog, getCategory, getProductsByCategory } from "../../data/catalog";
import { withBase } from "../../data/paths";

export function getStaticPaths() {
  return catalog.categories.map((category) => ({
    params: { category: category.slug },
  }));
}

const { category: slug } = Astro.params;
const category = getCategory(slug!);
if (!category) {
  throw new Error(`Neznámá kategorie: ${slug}`);
}

const products = getProductsByCategory(category.slug);
---

<BaseLayout title={category.title} description={category.description}>
  <div class="container page">
    <header class="page-header">
      <h1>{category.title}</h1>
      <p class="page-header__lead">{category.description}</p>
      <a class="btn btn-primary" href={withBase("/nabidka/")}>Celá nabídka e-shopu</a>
    </header>
    <CatalogListing products={products} />
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-xl) var(--space-3xl);
  }

  .page-header {
    text-align: center;
    max-width: 46rem;
    margin: 0 auto var(--space-xl);
  }

  .page-header h1 {
    margin: 0 0 var(--space-md);
  }

  .page-header__lead {
    margin: 0 0 var(--space-lg);
    color: var(--text);
    line-height: 1.85;
  }
</style>
