---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articles } from "../../data/articles";
import { withBase } from "../../data/paths";
---

<BaseLayout
  title="Články"
  description="Novinky, kolekce, tipy a návody z dílny Decorater – vše o dekoracích a květinových boxech."
>
  <div class="container page">
    <header class="page-header">
      <h1>Články</h1>
      <p class="lead">Novinky, kolekce, tipy a návody z dílny Decorater.</p>
    </header>

    <ul class="list">
      {
        articles.map((article) => (
          <li>
            <a href={withBase(`/nase-novinky/${article.slug}/`)}>
              <h2>{article.title}</h2>
              <p>{article.excerpt}</p>
              <span>Číst článek</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-xl) var(--space-3xl);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .lead {
    max-width: 36rem;
    margin: 0 auto;
    color: var(--text);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    max-width: 46rem;
    margin-inline: auto;
  }

  .list a {
    display: block;
    text-decoration: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .list h2 {
    margin: 0 0 var(--space-sm);
    font-size: 1.45rem;
  }

  .list p {
    margin: 0 0 var(--space-md);
    line-height: 1.85;
  }

  .list span {
    font-weight: 700;
  }
</style>
