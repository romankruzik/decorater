---
import type { HeroFeature, HeroSlide } from "../data/catalog";
import { withBase } from "../data/paths";
import Icon from "./Icon.astro";

interface Props {
  slides: HeroSlide[];
}

const { slides } = Astro.props;
const id = `hero-${Math.random().toString(36).slice(2, 9)}`;

const featurePaths: Record<HeroFeature["icon"], string> = {
  leaf: "M12 4c4.2 4.4 7.5 8.6 7.5 12a7.5 7.5 0 1 1-15 0C4.5 12.6 7.8 8.4 12 4Zm0 0v16",
  hands:
    "M12 20.7 4.3 12.9A5.15 5.15 0 0 1 12 6.1a5.15 5.15 0 0 1 7.7 6.8Z",
  home: "M4 11.5 12 4l8 7.5V20H15v-6H9v6H4Z",
  gift: "M4 10.5h16V21H4Zm0-3.5h16v3.5H4ZM12 3.2c-2.4 0-4 1.8-4 3.8h8c0-2-1.6-3.8-4-3.8ZM12 7v14",
};
---

<section class="hero" aria-label="Hlavní bannery">
  <div class="hero__viewport" data-hero={id}>
    <div class="hero__track">
      {
        slides.map((slide, index) => (
          <article class="hero__slide" data-slide aria-label={slide.alt} hidden={index !== 0 ? true : undefined}>
            <div class="hero__media" style={`background-image: url('${withBase(slide.src)}')`}>
              <img
                src={withBase(slide.src)}
                alt=""
                width="1920"
                height="1080"
                fetchpriority={index === 0 ? "high" : "low"}
                loading={index === 0 ? "eager" : "lazy"}
              />
            </div>
            <div class="hero__content">
              {
                slide.kicker && (
                  <p class="hero__kicker">
                    <span class="hero__kicker-line" aria-hidden="true"></span>
                    <span>{slide.kicker}</span>
                    <span class="hero__kicker-line" aria-hidden="true"></span>
                  </p>
                )
              }
              {
                slide.scriptTitle && (
                  <h2 class="hero__script">{slide.scriptTitle}</h2>
                )
              }
              {slide.title && <h2 class="hero__title">{slide.title}</h2>}
              <p class="hero__text">{slide.text}</p>
              <ul class="hero__features">
                {slide.features.map((feature) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={featurePaths[feature.icon]}></path>
                    </svg>
                    <span>{feature.label}</span>
                  </li>
                ))}
              </ul>
              <a class="hero__cta" href={withBase(slide.href)}>
                {slide.cta}
                <Icon name="chevron-right" size={20} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
    {
      slides.length > 1 && (
        <>
          <button type="button" class="hero__nav hero__nav--prev" data-hero-prev aria-label="Předchozí slide">
            <Icon name="chevron-left" size={28} />
          </button>
          <button type="button" class="hero__nav hero__nav--next" data-hero-next aria-label="Další slide">
            <Icon name="chevron-right" size={28} />
          </button>
          <div class="hero__dots" role="tablist" aria-label="Výběr banneru">
            {slides.map((_, index) => (
              <button
                type="button"
                class="hero__dot"
                data-hero-dot={index}
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-label={`Banner ${index + 1}`}
              />
            ))}
          </div>
        </>
      )
    }
  </div>
</section>

<script define:vars={{ id, slideCount: slides.length }}>
  const root = document.querySelector(`[data-hero="${id}"]`);
  if (!root || slideCount < 2) {
    root?.querySelectorAll("[data-slide]").forEach((el, i) => {
      if (i === 0) el.removeAttribute("hidden");
    });
  } else {
    const slides = [...root.querySelectorAll("[data-slide]")];
    const dots = [...root.querySelectorAll("[data-hero-dot]")];
    let index = 0;
    let timer;

    const show = (i) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((el, n) => {
        if (n === index) el.removeAttribute("hidden");
        else el.setAttribute("hidden", "");
      });
      dots.forEach((dot, n) => dot.setAttribute("aria-selected", n === index ? "true" : "false"));
    };

    let started = false;

    const restart = () => {
      clearInterval(timer);
      timer = setInterval(() => show(index + 1), 12000);
    };

    const start = () => {
      started = true;
      restart();
    };

    root.addEventListener("mouseenter", () => clearInterval(timer));
    root.addEventListener("mouseleave", () => {
      if (started) restart();
    });

    root.querySelector("[data-hero-prev]")?.addEventListener("click", () => {
      show(index - 1);
      start();
    });
    root.querySelector("[data-hero-next]")?.addEventListener("click", () => {
      show(index + 1);
      start();
    });
    dots.forEach((dot) =>
      dot.addEventListener("click", () => {
        show(Number(dot.getAttribute("data-hero-dot")));
        start();
      }),
    );

    show(0);
  }
</script>

<style>
  .hero {
    margin-bottom: var(--space-xl);
  }

  .hero__viewport {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    min-height: calc(100svh - var(--header-height));
  }

  .hero__track,
  .hero__slide {
    min-height: inherit;
  }

  .hero__slide {
    position: relative;
    display: grid;
    align-items: center;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
  }

  .hero__media img {
    width: 100%;
    max-width: none;
    height: 100% !important;
    max-height: none;
    object-fit: cover;
    object-position: right center;
  }

  .hero__slide::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(247, 241, 235, 0.97) 0%,
      rgba(247, 241, 235, 0.93) 38%,
      rgba(247, 241, 235, 0.72) 52%,
      rgba(247, 241, 235, 0.28) 68%,
      rgba(247, 241, 235, 0) 84%
    );
  }

  .hero__content {
    --hero-left: max(1.25rem, calc((100vw - min(100vw - 2.5rem, var(--content-max))) / 2));
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(2.4rem, 4.2vw, 3.75rem);
    width: min(100%, 54rem);
    padding: var(--space-xl) 4.5rem var(--space-2xl) var(--hero-left);
    color: var(--plum);
    text-align: left;
  }

  .hero__content::before {
    content: "";
    position: absolute;
    z-index: -1;
    pointer-events: none;
    top: 0;
    right: -2.25rem;
    bottom: 0;
    left: -1.5rem;
    background: linear-gradient(
      90deg,
      rgba(247, 241, 235, 0.9) 0%,
      rgba(247, 241, 235, 0.78) 70%,
      rgba(247, 241, 235, 0) 100%
    );
    mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
  }

  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 3.15rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.1;
    text-transform: uppercase;
    text-align: left;
    color: var(--plum);
  }

  .hero__kicker-line {
    width: 3.25rem;
    height: 1.5px;
    background: var(--plum);
    opacity: 0.7;
    flex-shrink: 0;
  }

  .hero__title {
    margin: 0;
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(3.1rem, 7.2vw, 5.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-align: left;
    color: var(--plum);
  }

  .hero__script {
    margin: 0;
    font-family: "Great Vibes", var(--font-display);
    font-size: clamp(3.8rem, 9vw, 7.2rem);
    font-weight: 400;
    font-style: normal;
    line-height: 0.95;
    white-space: nowrap;
    text-align: left;
    color: var(--plum);
  }

  .hero__text {
    margin: 0;
    max-width: 38rem;
    font-family: var(--font-body);
    font-size: clamp(1.12rem, 1.7vw, 1.32rem);
    font-weight: 500;
    line-height: 1.85;
    text-align: left;
    color: var(--plum);
  }

  .hero__features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-items: start;
    gap: 1.1rem 1.6rem;
    width: 100%;
    max-width: 36rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__features li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    text-align: left;
  }

  .hero__features svg {
    box-sizing: content-box;
    width: 2.55rem;
    height: 2.55rem;
    overflow: visible;
    fill: none;
    stroke: var(--plum);
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero__features span {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.25;
    text-transform: uppercase;
    text-align: left;
    color: var(--plum);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3.75rem;
    padding: 1rem 1.9rem;
    border-radius: 999px;
    background: var(--plum);
    color: var(--white);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    width: fit-content;
  }

  .hero__cta:hover {
    background: var(--dark);
    color: var(--white);
  }

  .hero__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    color: var(--text);
    background: rgba(255, 255, 255, 0.92);
    cursor: pointer;
    box-shadow: var(--shadow-soft);
  }

  .hero__nav--prev {
    left: var(--space-md);
  }

  .hero__nav--next {
    right: var(--space-md);
  }

  .hero__nav:hover {
    color: var(--gold);
  }

  .hero__dots {
    position: absolute;
    left: 50%;
    bottom: var(--space-md);
    z-index: 3;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
  }

  .hero__dot {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    cursor: pointer;
  }

  .hero__dot[aria-selected="true"] {
    width: 1.25rem;
    background: var(--white);
  }

  @media (min-width: 960px) {
    .hero {
      margin-bottom: var(--space-2xl);
    }

    .hero__viewport {
      min-height: max(42rem, calc(100svh - var(--header-height)));
    }

    .hero__content {
      gap: 3.85rem;
      padding: 2.75rem 3rem 3.25rem var(--hero-left);
    }
  }

  @media (min-width: 1680px) {
    .hero__slide::before {
      background: linear-gradient(
        90deg,
        rgba(247, 241, 235, 0.42) 0%,
        rgba(247, 241, 235, 0.18) 30%,
        rgba(247, 241, 235, 0) 52%
      );
    }

    .hero__content::before {
      opacity: 0.28;
    }
  }

  @media (max-width: 640px) {
    .hero__slide::before {
      background: linear-gradient(
        180deg,
        rgba(247, 241, 235, 0.94) 0%,
        rgba(247, 241, 235, 0.78) 42%,
        rgba(247, 241, 235, 0.28) 100%
      );
    }

    .hero__script {
      white-space: normal;
    }

    .hero__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 18rem;
    }

    .hero__content {
      padding: var(--space-lg) 1.25rem 5.25rem 1.25rem;
    }

    .hero__content::before {
      inset: 0;
    }
  }

  @media (max-width: 959px) {
    .hero__content {
      padding-bottom: 5.25rem;
    }

    .hero__nav {
      top: auto;
      bottom: 1rem;
      transform: none;
    }

    .hero__nav--prev {
      left: 1rem;
    }

    .hero__nav--next {
      right: 1rem;
    }

    .hero__dots {
      bottom: 1.45rem;
    }
  }
</style>
