---
import { shopUrl } from "../data/site";
import { withBase } from "../data/paths";
---

<div class="login-dialog" id="login-dialog" hidden data-login-dialog>
  <div class="login-dialog__panel" role="dialog" aria-labelledby="login-heading" aria-modal="true">
    <div class="login-dialog__head">
      <h2 id="login-heading">Přihlášení k vašemu účtu</h2>
      <button type="button" class="login-dialog__close" data-login-close aria-label="Zavřít přihlášení">
        ×
      </button>
    </div>
    <form class="login-dialog__form" action={shopUrl("/action/Customer/Login/")} method="post">
      <label>
        E-mail
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        Heslo
        <input type="password" name="password" autocomplete="current-password" required />
      </label>
      <button class="btn btn-primary" type="submit">Přihlásit se</button>
    </form>
    <p class="login-dialog__links">
      <a href={withBase("/registrace/")}>Nová registrace</a>
      <a href={withBase("/klient/zapomenute-heslo/")}>Zapomenuté heslo</a>
    </p>
  </div>
</div>

<style>
  .login-dialog {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: grid;
    place-items: start end;
    padding: calc(var(--header-height) + 0.6rem) 1.25rem 1.25rem;
    background: rgba(76, 57, 69, 0.18);
  }

  .login-dialog__panel {
    width: min(100%, 24rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: var(--space-lg);
  }

  .login-dialog__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--space-md);
  }

  .login-dialog__head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--plum);
  }

  .login-dialog__close {
    border: 0;
    background: transparent;
    color: var(--plum);
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.15rem;
  }

  .login-dialog__form {
    display: grid;
    gap: 0.9rem;
  }

  .login-dialog__form label {
    display: grid;
    gap: 0.4rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--plum);
  }

  .login-dialog__form input {
    width: 100%;
    min-height: 2.8rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--text);
    font: inherit;
  }

  .login-dialog__form input:focus {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  .login-dialog__form .btn {
    width: 100%;
    margin-top: 0.25rem;
  }

  .login-dialog__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    margin: 1.1rem 0 0;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .login-dialog__links a {
    color: var(--plum);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .login-dialog__links a:hover {
    color: var(--gold);
  }
</style>
